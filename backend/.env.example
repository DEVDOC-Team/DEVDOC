# DEVDOC backend environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --------------------------------------------------------
# Application
# --------------------------------------------------------
APP_NAME="DEVDOC API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG="true"
HOST="0.0.0.0"
PORT="8000"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --------------------------------------------------------
# API rate limiting — Phase 20
# Production requires a reachable shared Redis instance.
# Account quota is shared by authenticated routes; client-IP bucket
# protects unauthenticated endpoints and bursts.
# --------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_TENANT_CAPACITY=120
RATE_LIMIT_TENANT_REFILL_PER_SECOND=2
RATE_LIMIT_IP_CAPACITY=120
RATE_LIMIT_IP_REFILL_PER_SECOND=10
RATE_LIMIT_MEMORY_MAX_ENTRIES=10000

# --------------------------------------------------------
# Database — PostgreSQL / Supabase
#
# DATABASE_URL: async URL used by FastAPI at runtime
#   format: postgresql+asyncpg://user:password@host:port/database
#
# DIRECT_DATABASE_URL: synchronous URL used by Alembic migrations
#   format: postgresql+psycopg2://user:password@host:port/database
#
# For Supabase you can find these under:
#   Project Settings → Database → Connection string
# --------------------------------------------------------
DATABASE_URL=
DIRECT_DATABASE_URL=

# Database connection pool (optional — sensible defaults apply)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --------------------------------------------------------
# Supabase & Authentication
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY is backend-only.
#            NEVER expose it to the frontend or commit it.
# --------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret (Dashboard -> Project Settings -> API -> JWT Secret)
# Used to cryptographically verify incoming Supabase access tokens.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM="HS256"
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWT_ISSUER=

# --------------------------------------------------------
# GitHub Integration (Phase 7)
# --------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI="http://localhost:8000/api/v1/github/callback"
GITHUB_API_BASE_URL="https://api.github.com"

# --------------------------------------------------------
# LLM reasoning — Phase 13 (disabled unless explicitly enabled)
# Keep NEBIUS_API_KEY server-side. Never add it to frontend configuration.
# Set both prices from the current Nebius model pricing before enabling.
# --------------------------------------------------------
LLM_ENABLED=false
NEBIUS_API_KEY=
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1"
NEBIUS_MODEL="nvidia/Llama-3.1-Nemotron-70B-Instruct"
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_MAX_INPUT_TOKENS=12000
LLM_MAX_OUTPUT_TOKENS=1000
LLM_BUDGET_USD=25
LLM_BUDGET_LEDGER_PATH=".devdoc-llm-budget.sqlite3"
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
LLM_CACHE_TTL_SECONDS=900
LLM_CACHE_MAX_ENTRIES=128

# --------------------------------------------------------
# Knowledge search — Phase 14 (disabled unless explicitly enabled)
# Keep TAVILY_API_KEY server-side. Search results are untrusted references,
# not incident facts. No result URL is automatically fetched.
# --------------------------------------------------------
KNOWLEDGE_SEARCH_ENABLED=false
TAVILY_API_KEY=
KNOWLEDGE_SEARCH_TIMEOUT_SECONDS=8
KNOWLEDGE_SEARCH_MAX_RESULTS=5
KNOWLEDGE_SEARCH_MAX_QUERY_LENGTH=400
KNOWLEDGE_SEARCH_MAX_RESPONSE_BYTES=250000
KNOWLEDGE_SEARCH_MAX_RETRIES=1
KNOWLEDGE_SEARCH_RETRY_BACKOFF_SECONDS=0.25
KNOWLEDGE_SEARCH_DEPTH="basic"
# Comma-separated bare domains, e.g. "kubernetes.io,docs.docker.com"
KNOWLEDGE_SEARCH_PREFERRED_DOMAINS=
# Optional strict allow-list; when set, results from other domains are discarded.
KNOWLEDGE_SEARCH_ALLOWED_DOMAINS=
KNOWLEDGE_SEARCHES_PER_INVESTIGATION=2
KNOWLEDGE_SEARCHES_PER_REQUEST=1
KNOWLEDGE_SEARCH_MAX_CONCURRENT=2
KNOWLEDGE_SEARCH_MAX_TITLE_LENGTH=512
KNOWLEDGE_SEARCH_MAX_CONTENT_LENGTH=2000
KNOWLEDGE_SEARCH_MAX_URL_LENGTH=2048
KNOWLEDGE_SEARCH_CACHE_TTL_SECONDS=600
KNOWLEDGE_SEARCH_CACHE_MAX_ENTRIES=128
KNOWLEDGE_SEARCH_USAGE_WINDOW_SECONDS=86400
KNOWLEDGE_SEARCH_USAGE_MAX_ENTRIES=10000
