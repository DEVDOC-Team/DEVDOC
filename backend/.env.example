# DEVDOC backend environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --------------------------------------------------------
# Application
# --------------------------------------------------------
APP_NAME="DEVDOC API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG="true"
HOST="0.0.0.0"
PORT="8000"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --------------------------------------------------------
# Database — PostgreSQL / Supabase
#
# DATABASE_URL: async URL used by FastAPI at runtime
#   format: postgresql+asyncpg://user:password@host:port/database
#
# DIRECT_DATABASE_URL: synchronous URL used by Alembic migrations
#   format: postgresql+psycopg2://user:password@host:port/database
#
# For Supabase you can find these under:
#   Project Settings → Database → Connection string
# --------------------------------------------------------
DATABASE_URL=
DIRECT_DATABASE_URL=

# Database connection pool (optional — sensible defaults apply)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --------------------------------------------------------
# Supabase & Authentication
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY is backend-only.
#            NEVER expose it to the frontend or commit it.
# --------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret (Dashboard -> Project Settings -> API -> JWT Secret)
# Used to cryptographically verify incoming Supabase access tokens.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM="HS256"
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWT_ISSUER=

# --------------------------------------------------------
# GitHub Integration (Phase 7)
# --------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI="http://localhost:8000/api/v1/github/callback"
GITHUB_API_BASE_URL="https://api.github.com"

# --------------------------------------------------------
# LLM reasoning — Phase 13 (disabled unless explicitly enabled)
# Keep NEBIUS_API_KEY server-side. Never add it to frontend configuration.
# Set both prices from the current Nebius model pricing before enabling.
# --------------------------------------------------------
LLM_ENABLED=false
NEBIUS_API_KEY=
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1"
NEBIUS_MODEL="nvidia/Llama-3.1-Nemotron-70B-Instruct"
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_MAX_INPUT_TOKENS=12000
LLM_MAX_OUTPUT_TOKENS=1000
LLM_BUDGET_USD=25
LLM_BUDGET_LEDGER_PATH=".devdoc-llm-budget.sqlite3"
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
LLM_CACHE_TTL_SECONDS=900
LLM_CACHE_MAX_ENTRIES=128
