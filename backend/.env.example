# DEVDOC backend environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --------------------------------------------------------
# Application
# --------------------------------------------------------
APP_NAME="DEVDOC API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG="true"
HOST="0.0.0.0"
PORT="8000"
# Local origins for development. Production must list the deployed frontend origin(s).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --------------------------------------------------------
# API rate limiting — Phase 20
# Production requires a reachable shared Redis instance.
# Account quota is shared by authenticated routes; client-IP bucket
# protects unauthenticated endpoints and bursts.
# --------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_TENANT_CAPACITY=120
RATE_LIMIT_TENANT_REFILL_PER_SECOND=2
RATE_LIMIT_IP_CAPACITY=120
RATE_LIMIT_IP_REFILL_PER_SECOND=10
RATE_LIMIT_MEMORY_MAX_ENTRIES=10000

# --------------------------------------------------------
# Database — PostgreSQL / Supabase
#
# DATABASE_URL: async URL used by FastAPI at runtime
#   format: postgresql+asyncpg://user:password@host:port/database
#
# DIRECT_DATABASE_URL: URL used by Alembic migrations
#   format: postgresql+asyncpg://user:password@host:port/database
#
# Both variables may use the same Supabase Session Pooler URL. The backend
# normalizes a standard postgresql:// URL to postgresql+asyncpg://.
# Find the Session Pooler URL under the Supabase project's Connect dialog.
# --------------------------------------------------------
DATABASE_URL=
DIRECT_DATABASE_URL=

# Database connection pool (optional — sensible defaults apply)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --------------------------------------------------------
# Supabase & Authentication
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY is backend-only.
#            NEVER expose it to the frontend or commit it.
# --------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Verification Settings
# For modern Supabase projects using asymmetric ES256 signing:
# - Set SUPABASE_JWT_ALGORITHM="ES256"
# - Public verification keys are retrieved automatically from:
#   ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# - SUPABASE_JWT_SECRET is unused for ES256 verification (preserved for HMAC fallback/OAuth CSRF)
# - SUPABASE_JWT_ISSUER defaults to ${SUPABASE_URL}/auth/v1
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM="ES256"
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWT_ISSUER=
# Allow limited clock skew between Supabase and the API host when validating JWT time claims.
SUPABASE_JWT_CLOCK_SKEW_SECONDS=60

# --------------------------------------------------------
# GitHub Integration (Phase 7)
# --------------------------------------------------------
# These values are for Repositories > Connect GitHub, not the website's GitHub sign-in button.
# Configure website Google/GitHub sign-in separately in Supabase Dashboard > Authentication > Sign In / Providers.
# Add Supabase's GitHub callback URL to the OAuth app and allow http://localhost:5173/ in Supabase URL Configuration.
# Use the OAuth App's Client ID (not App ID) and generated Client Secret value from the same app.
# These credentials identify DEVDOC's OAuth App; users can authorize with their own GitHub accounts.
# Register the callback URL below in that app's user authorization callback settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI="http://127.0.0.1:8000/api/v1/github/callback"
GITHUB_API_BASE_URL="https://api.github.com"

# --------------------------------------------------------
# LLM reasoning — Phase 13 (disabled unless explicitly enabled)
# Keep NEBIUS_API_KEY server-side. Never add it to frontend configuration.
# Set both prices from the current Nebius model pricing before enabling.
# --------------------------------------------------------
LLM_ENABLED=false
NEBIUS_API_KEY=
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1"
NEBIUS_MODEL="nvidia/Nemotron-3_5-Lightning"
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_MAX_INPUT_TOKENS=12000
LLM_MAX_OUTPUT_TOKENS=2500
LLM_BUDGET_USD=2
LLM_BUDGET_LEDGER_PATH=".devdoc-llm-budget.sqlite3"
# Current Nebius Token Factory pricing for Nemotron-3.5-Lightning ($0.06 / $0.24 per 1M tokens)
LLM_INPUT_COST_PER_MILLION_USD=0.06
LLM_OUTPUT_COST_PER_MILLION_USD=0.24
LLM_CACHE_TTL_SECONDS=900
LLM_CACHE_MAX_ENTRIES=128

# --------------------------------------------------------
# Knowledge search — Phase 14 (disabled unless explicitly enabled)
# Keep TAVILY_API_KEY server-side. Search results are untrusted references,
# not incident facts. No result URL is automatically fetched.
# --------------------------------------------------------
KNOWLEDGE_SEARCH_ENABLED=false
TAVILY_API_KEY=
KNOWLEDGE_SEARCH_TIMEOUT_SECONDS=8
KNOWLEDGE_SEARCH_MAX_RESULTS=5
KNOWLEDGE_SEARCH_MAX_QUERY_LENGTH=400
KNOWLEDGE_SEARCH_MAX_RESPONSE_BYTES=250000
KNOWLEDGE_SEARCH_MAX_RETRIES=1
KNOWLEDGE_SEARCH_RETRY_BACKOFF_SECONDS=0.25
KNOWLEDGE_SEARCH_DEPTH="basic"
# Comma-separated bare domains, e.g. "kubernetes.io,docs.docker.com"
KNOWLEDGE_SEARCH_PREFERRED_DOMAINS=
# Optional strict allow-list; when set, results from other domains are discarded.
KNOWLEDGE_SEARCH_ALLOWED_DOMAINS=
KNOWLEDGE_SEARCHES_PER_INVESTIGATION=2
KNOWLEDGE_SEARCHES_PER_REQUEST=1
KNOWLEDGE_SEARCH_MAX_CONCURRENT=2
KNOWLEDGE_SEARCH_MAX_TITLE_LENGTH=512
KNOWLEDGE_SEARCH_MAX_CONTENT_LENGTH=2000
KNOWLEDGE_SEARCH_MAX_URL_LENGTH=2048
KNOWLEDGE_SEARCH_CACHE_TTL_SECONDS=600
KNOWLEDGE_SEARCH_USAGE_WINDOW_SECONDS=86400
KNOWLEDGE_SEARCH_USAGE_MAX_ENTRIES=10000

# --------------------------------------------------------
# Observability & Metrics (Phase 21)
# --------------------------------------------------------
METRICS_ENABLED=true
METRICS_PATH="/metrics"
OPENTELEMETRY_ENABLED=false
OTLP_ENDPOINT=

# --------------------------------------------------------
# Database Read Replica Routing (Phase 24)
# --------------------------------------------------------
DATABASE_REPLICA_URL=
