# DEVDOC backend environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --------------------------------------------------------
# Application
# --------------------------------------------------------
APP_NAME="DEVDOC API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG="true"
HOST="0.0.0.0"
PORT="8000"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --------------------------------------------------------
# Database — PostgreSQL / Supabase
#
# DATABASE_URL: async URL used by FastAPI at runtime
#   format: postgresql+asyncpg://user:password@host:port/database
#
# DIRECT_DATABASE_URL: synchronous URL used by Alembic migrations
#   format: postgresql+psycopg2://user:password@host:port/database
#
# For Supabase you can find these under:
#   Project Settings → Database → Connection string
# --------------------------------------------------------
DATABASE_URL=
DIRECT_DATABASE_URL=

# Database connection pool (optional — sensible defaults apply)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --------------------------------------------------------
# Supabase & Authentication
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY is backend-only.
#            NEVER expose it to the frontend or commit it.
# --------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret (Dashboard -> Project Settings -> API -> JWT Secret)
# Used to cryptographically verify incoming Supabase access tokens.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM="HS256"
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWT_ISSUER=

# --------------------------------------------------------
# GitHub Integration (Phase 7)
# --------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI="http://localhost:8000/api/v1/github/callback"
GITHUB_API_BASE_URL="https://api.github.com"


