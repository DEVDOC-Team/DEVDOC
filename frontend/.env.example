# DEVDOC Frontend Configuration
# Local development only. For shared deployments, set this at build time to a
# FastAPI URL reachable by each browser (or leave it unset for same-origin proxying).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: Supabase public credentials for client-side authentication
# (Never place the service_role key here; only anon/publishable key is safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
