# DEVDOC Frontend Configuration
# Local development: use the local FastAPI server.
# Vercel: set this to https://devdoc-mse0.onrender.com, or leave it unset to use
# the same-origin /api proxy configured in vercel.json.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: Supabase public credentials for client-side authentication
# (Never place the service_role key here; only anon/publishable key is safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
